# -----------------------------------------------------------------------------
# Monorepo Infrastructure (Docker Compose Backing Services)
# Copy this file to .env:
#   cp .env.example .env
#
# NOTE: Individual service configs live in their own directories:
#   services/catalog/.env
#   services/frontier/.env
#   services/scraper/.env
#   services/textparser/.env
#   services/vision/.env
# -----------------------------------------------------------------------------

# NATS JetStream Container
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# PostgreSQL 18 Container
POSTGRES_USER=birdwatcher
POSTGRES_PASSWORD=birdwatcher
POSTGRES_DB=birdwatcher
POSTGRES_PORT=5432
