# Runtime
ENV=development
PORT=9090

# NATS JetStream
NATS_URL=nats://localhost:4222

# Crawl & Politeness Settings
CRAWL_HOST_DELAY=250ms
CRAWL_MAX_INFLIGHT_PER_HOST=2
