# -----------------------------------------------------------------------------
# Catalog Service Environment Configuration
# Copy this file to .env:
#   cp .env.example .env
# -----------------------------------------------------------------------------

# Runtime
ENV=development
PORT=8080

# Frontier Service Settings
FRONTIER_GRPC_ADDR=localhost:9090
FRONTIER_MAX_DEPTH=4
FRONTIER_MAX_PAGES=200

# NATS JetStream Settings
NATS_URL=nats://localhost:4222

# PostgreSQL Connection & Pool Settings
DATABASE_URL=postgres://birdwatcher:birdwatcher@localhost:5432/birdwatcher?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m
DATABASE_HEALTH_CHECK_PERIOD=30s
