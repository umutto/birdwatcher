{
  "cSpell.words": [
    "birdwatcherv",
    "bwnats",
    "Corasick",
    "DBTX",
    "errgroup",
    "flocci",
    "golangci",
    "gonats",
    "gopls",
    "goroutines",
    "healthcheck",
    "isready",
    "jackc",
    "jetstream",
    "oxfmt",
    "oxlint",
    "pgconn",
    "pgdata",
    "pgtype",
    "plpgsql",
    "protoc",
    "protocolbuffers",
    "pytest",
    "sqlc",
    "sqlfluff",
    "sqruff",
    "tailwindcss",
    "tanstack",
    "textparser",
    "timestamptz",
    "uuidv",
    "volar"
  ],
  "cSpell.ignorePaths": [
    "gen/",
    ".gitignore",
    "Dockerfile",
    ".github/**",
    ".vscode/**",
    ".golangci.yml",
    "go.sum",
    "go.mod",
    "web/pnpm-lock.yaml",
    ".sqlfluff"
  ],
  "[proto3]": {
    "editor.defaultFormatter": "bufbuild.vscode-buf",
    "editor.formatOnSave": true
  },
  "[protobuf]": {
    "editor.defaultFormatter": "bufbuild.vscode-buf",
    "editor.formatOnSave": true
  },
  "[go]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "[sql]": {
    "editor.defaultFormatter": "Quary.sqruff",
    "editor.formatOnSave": true
  },
  "[vue]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "python-envs.workspaceSearchPaths": [
    "services/vision"
  ],
  "python.terminal.activateEnvironment": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "tsconfig.json": "tsconfig.*.json, env.d.ts, typed-router.d.ts",
    "vite.config.*": "jsconfig*, vitest.config.*, cypress.config.*, playwright.config.*",
    "package.json": "package-lock.json, pnpm*, .yarnrc*, yarn*, .eslint*, eslint*, .oxlint*, oxlint*, .oxfmt*, .prettier*, prettier*, .editorconfig, bun.lock, nub.lock"
  },
  "typescript.tsdk": "web/node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  }
}
