{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "All Services",
      "configurations": [
        "Catalog Service",
        "Frontier Service",
        "Scraper Service",
        "Textparser Service",
        "Vision Service"
      ],
      "stopAll": true
    },
    {
      "name": "All Go Services",
      "configurations": [
        "Catalog Service",
        "Frontier Service",
        "Scraper Service",
        "Textparser Service"
      ],
      "stopAll": true
    }
  ],
  "configurations": [
    {
      "name": "Catalog Service",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/services/catalog/cmd/catalog",
      "cwd": "${workspaceFolder}/services/catalog",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Frontier Service",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/services/frontier",
      "cwd": "${workspaceFolder}/services/frontier",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Scraper Service",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/services/scraper",
      "cwd": "${workspaceFolder}/services/scraper",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Textparser Service",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/services/textparser",
      "cwd": "${workspaceFolder}/services/textparser",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Vision Service",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/services/vision/src/vision/main.py",
      "cwd": "${workspaceFolder}/services/vision",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}