#!/usr/bin/env bash
set -eo pipefail

base="$(git rev-parse --verify -q '@{u}' || git rev-parse --verify -q 'origin/main' || true)"
changed=""
if [ -n "$base" ]; then
    changed="$( (git diff --name-only "$base...HEAD"; git diff --name-only; git diff --name-only --cached; git ls-files --others --exclude-standard) | sort -u )"
    [ -z "$changed" ] && { echo "✅ No changes detected."; exit 0; }
fi

has_changed() { [ -z "$base" ] || grep -qE "$1" <<< "$changed"; }

# 1. Code generation & workspace drift
if [ -d "services/catalog" ] && has_changed '^services/catalog/(queries|migrations)/|^services/catalog/sqlc\.ya?ml$'; then
    (cd services/catalog && sqlc generate >/dev/null)
    git diff --quiet services/catalog/internal/repository/ || { echo "❌ sqlc drift detected. Run 'make sqlc'."; exit 1; }
fi

if [ -d "proto" ] && command -v buf >/dev/null 2>&1 && has_changed '^proto/'; then
    (cd proto && buf lint && buf generate >/dev/null)
    git diff --quiet gen/ || { echo "❌ Protobuf drift detected. Run 'make proto'."; exit 1; }
fi

if [ -f "go.work" ] && has_changed '(^|/)go\.(work|work\.sum|mod|sum)$'; then
    go work sync >/dev/null
    git diff --quiet go.work.sum || { echo "❌ go.work.sum drift detected. Run 'go work sync'."; exit 1; }
fi

# 2. Go lint & formatting (golangci-lint v2 checks gofumpt + gci + modernize)
if has_changed '\.go$|^go\.work|go\.(mod|sum)$|^\.golangci\.yml$|^proto/'; then
    targets=()
    if has_changed '^(shared/|gen/go/|proto/|go\.work|go\.work\.sum|\.golangci\.yml)'; then
        for d in services/* shared/*; do
            if [ -f "$d/go.mod" ]; then targets+=("./$d/..."); fi
        done
    else
        for d in services/*; do
            if [ -f "$d/go.mod" ] && has_changed "^$d/.*(\\.go|go\\.(mod|sum))$"; then
                targets+=("./$d/...")
            fi
        done
    fi
    if [ "${#targets[@]}" -gt 0 ]; then golangci-lint run "${targets[@]}"; fi
fi

# 3. SQL & Python lint
if [ -d "services/catalog" ] && command -v sqruff >/dev/null 2>&1 && has_changed '^services/catalog/.*\.sql$|^\.sqlfluff$'; then
    sqruff lint services/catalog
fi

if [ -d "services/vision" ] && command -v uv >/dev/null 2>&1 && has_changed '^services/vision/'; then
    (cd services/vision && uv run ruff format --check . && uv run ruff check .)
fi

echo "✅ Verification passed."
